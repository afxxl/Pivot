# 1. INVITE TEAM MEMBER
##########################################################

### Test 1.1 - Invite Member Successfully
# @name inviteMember
POST http://localhost:5000/api/admin/members/invite
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Sarah",
  "lastName": "Kim",
  "email": "afsalmohd393@gmail.com",
  "role": "member"
}

### Test 1.2 - Invite - Email Already Exists
POST http://localhost:5000/api/admin/members/invite
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "rahul@techcorp.com",
  "role": "member"
}

### Test 1.3 - Invite - Invalid Email Format
POST http://localhost:5000/api/admin/members/invite
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Mike",
  "lastName": "Ross",
  "email": "invalid-email",
  "role": "member"
}

### Test 1.4 - Invite - Missing Required Fields
POST http://localhost:5000/api/admin/members/invite
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Jane",
  "email": "jane@techcorp.com"
}

### Test 1.5 - Invite - Unauthorized (No Token)
POST http://localhost:5000/api/admin/members/invite
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "test@techcorp.com",
  "role": "member"
}

### test 1.6 - invite - invalid token
POST http://localhost:5000/api/admin/members/invite
content-type: application/json
authorization: bearer invalid_token_here

{
  "firstname": "test",
  "lastname": "user",
  "email": "test@techcorp.com",
  "role": "member"
}

